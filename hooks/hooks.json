{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/aloud-code.sh toggle",
          "timeout": 5,
          "async": false
        }]
      },
      {
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/aloud-code.sh user-prompt",
          "timeout": 30,
          "async": true
        }]
      }
    ],
    "PreToolUse": [{
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/aloud-code.sh pre-tool-use",
        "timeout": 30,
        "async": true
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/aloud-code.sh stop",
        "timeout": 30,
        "async": true
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/aloud-code.sh subagent-stop",
        "timeout": 30,
        "async": true
      }]
    }],
    "Notification": [{
      "matcher": "elicitation_dialog",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/aloud-code.sh notification",
        "timeout": 30,
        "async": true
      }]
    }],
    "SessionEnd": [{
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/aloud-code.sh session-end",
        "timeout": 30,
        "async": true
      }]
    }]
  }
}
